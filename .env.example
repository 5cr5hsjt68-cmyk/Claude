# Copier ce fichier en .env et remplir les valeurs. Ne jamais committer .env.

# Port du serveur
PORT=3000

# Durée du cache des actus, en minutes (1440 = 24 h, rafraîchissement quotidien)
NEWS_CACHE_TTL_MINUTES=1440

# Clé GNews (facultative, source de secours). Inscription gratuite : https://gnews.io/register
GNEWS_API_KEY=
